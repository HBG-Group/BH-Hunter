// Meino database schema.
// One campus for now (VSU Main), so there is no Campus table yet — campus settings
// live in src/config/campus.ts. When we expand, we add a Campus model and a
// campusId on BoardingHouse; nothing else here needs to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — the fixed vocabulary of the app (mirrors src/types/domain.ts)
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  OWNER
  ADMIN
}

enum GenderPolicy {
  MALE
  FEMALE
  MIXED
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum ImageType {
  PHOTO
  TOUR_360
}

enum NearbyCategory {
  LAUNDRY
  CONVENIENCE_STORE
  CAFE
  WATER_REFILL
  PRINTING_SHOP
  PHARMACY
  ATM
  JEEPNEY_STOP
  CLINIC
}

enum ViewingRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum AnalyticsEventType {
  VIEW
  CONTACT_CLICK
  FAVORITE
  VIEWING_REQUEST
}

enum ModerationAction {
  LISTING_VERIFICATION
  LISTING_STATUS
  LISTING_FEATURED
  LISTING_DELETION
  OWNER_VERIFICATION
  REVIEW_DELETION
  ADVERTISEMENT_CREATION
  ADVERTISEMENT_STATUS
  ADVERTISEMENT_DELETION
}

// ---------------------------------------------------------------------------
// People. Profile.id matches the Supabase Auth user id (auth.users.id).
// ---------------------------------------------------------------------------

model Profile {
  id                      String    @id
  role                    Role      @default(STUDENT)
  fullName                String
  email                   String    @unique
  phone                   String?
  avatarUrl               String? // profile photo (auto-filled from Google when available)
  verified                Boolean   @default(false) // admin-granted "Verified Owner" trust badge
  verifiedUntil           DateTime? @db.Timestamptz(6) // when the current verification lapses (auto-expires monthly)
  verificationRequestedAt DateTime? @db.Timestamptz(6) // set when an owner requests verification; cleared once granted
  frozen                  Boolean   @default(false) // admin-frozen owner: read-only, blocked from the dashboard
  plan                    String? // admin-assigned pricing plan: BASIC | ADVANCE | PREMIUM (null = none)
  ownerTutorialCompleted  Boolean   @default(false) // has the owner finished/skipped onboarding once
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  boardingHouses         BoardingHouse[]         @relation("OwnerListings")
  reviews                Review[]
  favorites              Favorite[]
  viewingRequests        ViewingRequest[]
  notifications          Notification[]
  recentlyViewed         RecentlyViewed[]
  notificationPreference NotificationPreference?
  subscription           Subscription?
  moderationEvents       ModerationEvent[]       @relation("ModerationActor")

  @@map("profiles")
}

// Scaffolding for a future owner subscription (Phase 2). Nothing enforces it yet —
// no code reads status to gate features. See docs/CACHING.md roadmap and config/billing.ts.
model Subscription {
  id      String  @id @default(cuid())
  ownerId String  @unique
  owner   Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  plan             String    @default("FREE") // FREE | OWNER_MONTHLY
  status           String    @default("INACTIVE") // INACTIVE | ACTIVE | PAST_DUE | CANCELLED
  startedAt        DateTime?
  expiresAt        DateTime?
  renewalDate      DateTime?
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// Scaffolding for local business ads (Part 6). Admin-managed; not rendered yet.
model Advertisement {
  id           String    @id @default(cuid())
  title        String
  description  String?
  imageUrls    String[] // uploaded to Supabase Storage, first is the cover
  websiteUrl   String?
  facebookUrl  String?
  messengerUrl String?
  startAt      DateTime  @default(now())
  expiresAt    DateTime?
  active       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, expiresAt])
  @@map("advertisements")
}

// A student's recently viewed listings. One row per student+listing (upserted).
model RecentlyViewed {
  studentId       String
  boardingHouseId String
  student         Profile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  viewedAt        DateTime      @default(now())

  @@id([studentId, boardingHouseId])
  @@index([studentId, viewedAt])
  @@map("recently_viewed")
}

// Per-student notification settings. One row per student.
model NotificationPreference {
  studentId           String  @id
  student             Profile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roomAvailableAlerts Boolean @default(true)

  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// The core entity: a boarding house listing.
// ---------------------------------------------------------------------------

model BoardingHouse {
  id      String  @id @default(cuid())
  slug    String  @unique
  ownerId String
  owner   Profile @relation("OwnerListings", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  addressLine String
  latitude    Float
  longitude   Float

  genderPolicy      GenderPolicy
  priceMonthly      Int // lowest room price, in PHP
  advanceMonths     Int          @default(1)
  depositMonths     Int          @default(1)
  utilitiesIncluded Boolean      @default(false)
  internetIncluded  Boolean      @default(false)

  curfew     String?
  houseRules String?

  contactPhone String
  messengerUrl String?
  contactEmail String?

  status          ListingStatus @default(DRAFT)
  featured        Boolean       @default(false) // admin-promoted; shown first on the homepage
  lastConfirmedAt DateTime? // last time the owner confirmed vacancies
  verifiedAt      DateTime? // set by an admin after verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms           Room[]
  amenities       BoardingHouseAmenity[]
  images          Image[]
  nearbyPlaces    NearbyPlace[]
  reviews         Review[]
  favorites       Favorite[]
  viewingRequests ViewingRequest[]
  analyticsEvents AnalyticsEvent[]
  recentlyViewed  RecentlyViewed[]

  @@index([status])
  @@index([ownerId])
  @@index([featured])
  @@map("boarding_houses")
}

// Availability is derived by counting rooms, so vacancy can never contradict them.
model Room {
  id              String        @id @default(cuid())
  boardingHouseId String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)

  label        String
  capacity     Int
  occupied     Int    @default(0)
  priceMonthly Int?

  @@index([boardingHouseId])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Amenities — a shared catalog plus a join table per boarding house.
// ---------------------------------------------------------------------------

model Amenity {
  id    String @id @default(cuid())
  key   String @unique
  label String

  boardingHouses BoardingHouseAmenity[]

  @@map("amenities")
}

model BoardingHouseAmenity {
  boardingHouseId String
  amenityId       String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  amenity         Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([boardingHouseId, amenityId])
  @@map("boarding_house_amenities")
}

// ---------------------------------------------------------------------------
// Media, nearby places, reviews, and student-side records.
// ---------------------------------------------------------------------------

model Image {
  id              String        @id @default(cuid())
  boardingHouseId String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)

  url       String    @unique
  type      ImageType @default(PHOTO)
  alt       String?
  sortOrder Int       @default(0)

  @@index([boardingHouseId])
  @@map("images")
}

model NearbyPlace {
  id              String        @id @default(cuid())
  boardingHouseId String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)

  category    NearbyCategory
  name        String
  walkMinutes Int

  @@index([boardingHouseId])
  @@map("nearby_places")
}

model Review {
  id              String        @id @default(cuid())
  boardingHouseId String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  authorId        String
  author          Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  overall           Int
  cleanliness       Int
  internet          Int
  safety            Int
  noiseLevel        Int
  waterSupply       Int
  ownerFriendliness Int
  body              String?
  isVerified        Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([boardingHouseId, authorId])
  @@index([boardingHouseId])
  @@index([authorId])
  @@map("reviews")
}

model Favorite {
  studentId       String
  boardingHouseId String
  student         Profile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([studentId, boardingHouseId])
  @@index([boardingHouseId])
  @@map("favorites")
}

model ViewingRequest {
  id              String        @id @default(cuid())
  studentId       String
  boardingHouseId String
  student         Profile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)

  preferredAt DateTime
  status      ViewingRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime             @default(now())

  @@unique([studentId, boardingHouseId, preferredAt])
  @@index([boardingHouseId])
  @@index([studentId])
  @@map("viewing_requests")
}

// Durable record of privileged moderation decisions. Target IDs are scalar fields
// so history remains available even when a moderated record is deleted.
model ModerationEvent {
  id         String           @id @default(cuid())
  actorId    String
  actor      Profile          @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     ModerationAction
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime         @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("moderation_events")
}

// One row per meaningful action, so owner analytics can be aggregated later.
model AnalyticsEvent {
  id              String        @id @default(cuid())
  boardingHouseId String
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)

  type      AnalyticsEventType
  createdAt DateTime           @default(now())

  @@index([boardingHouseId, type])
  @@map("analytics_events")
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String
  title  String
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Shared fixed-window counters. This table is private to the server-side Prisma
// connection and is never exposed through the Supabase Data API.
model RateLimitWindow {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limit_windows")
}
