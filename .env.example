# Copy to .env.local and fill in values from the intended Supabase project.
# Runtime connection: Supabase Database -> Connection string -> Session pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma schema changes and backups (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase API settings. The anon key is public; service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# Canonical HTTPS origin; required for production deployments and OAuth callbacks.
NEXT_PUBLIC_SITE_URL="https://<your-production-domain>"

# Use a long, random, independent secret in production.
UPLOAD_TICKET_SECRET="<random-secret>"

# Optional: separate admin hostname, for example admin.example.com.
ADMIN_HOST=""

# Optional email delivery settings.
RESEND_API_KEY=""
RESEND_FROM=""

# Optional shared cache; listing reads work without Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: encrypted backup and restore tools.
BACKUP_ENCRYPTION_KEY=""
RESTORE_DIRECT_URL=""

# Local development only, for an approved tunnel hostname.
DEV_TUNNEL_HOST=""
